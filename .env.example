# Example .env for anymail-mcp
# Copy this file to .env and fill in your credentials.
# DO NOT commit the real .env file - it's in .gitignore.

# ============================================================
# IMAP (reading mail)
# ============================================================
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=you@example.com
IMAP_PASS=your-password-or-app-password
IMAP_REJECT_UNAUTHORIZED=true

# ============================================================
# SMTP (sending mail)
# ============================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=your-password-or-app-password
SMTP_REJECT_UNAUTHORIZED=true
# SMTP_FROM=alias@example.com   # Optional: override "From" address

# ============================================================
# MCP server
# ============================================================
FASTMCP_TRANSPORT=httpStream
FASTMCP_PORT=3143
FASTMCP_HOST=0.0.0.0

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=info
LOG_DIR=./logs

# ============================================================
# Security (all OPTIONAL - uncomment to enable)
# ============================================================

# Bearer token for HTTP transport authentication.
# If set, clients must send "Authorization: Bearer <token>" header.
# Generate one with: openssl rand -hex 32
# AUTH_TOKEN=your-secret-bearer-token-here

# Restrict who can receive emails (domain allowlist).
# Comma-separated list of allowed recipient domains.
# If unset, all valid email addresses are allowed.
# ALLOWED_DOMAINS=example.com,myorg.org

# Redact email addresses and secrets in log files (default: true).
# Set to false only for debugging.
# REDACT_LOGS=true